rules_version = '2';

// Reglas para Yapa (proyecto kiosko-45709, Plan Spark).
//
// El kiosco opera sin Firebase Auth: admin, vendedor y clientes
// comparten lectura/escritura directa sobre las colecciones de la app.
// La API key web es pública por diseño; para endurecer más adelante se
// puede activar App Check o Firebase Auth y ajustar estos allow.
//
// Publicar en: Firebase Console → Firestore Database → Reglas →
// pegar este contenido → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo, clientes, operación y configuración del kiosco.
    match /{collection}/{docId} {
      allow read, write: if collection in [
        'productos', 'clientes', 'ventas', 'encargos',
        'solicitudes', 'notificaciones', 'personal',
        'configuracion', 'meta'
      ];
    }
  }
}
